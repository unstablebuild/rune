# Headscale configuration for the rune:// end-to-end tests.
#
# The embedded DERP region is advertised but never needed: both Rune
# instances run on the test host and connect directly. It is enabled so
# the setup stays hermetic — with `derp.urls` empty, nothing reaches out
# to Tailscale's public DERP map, so the tests run offline.
server_url: {{ .ServerURL }}
listen_addr: 0.0.0.0:{{ .HTTPPort }}
metrics_listen_addr: 0.0.0.0:9090
grpc_listen_addr: 0.0.0.0:50443
grpc_allow_insecure: false
noise:
  private_key_path: /var/lib/headscale/noise_private.key
prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48
  allocation: sequential
derp:
  server:
    enabled: true
    region_id: 999
    region_code: headscale
    region_name: Headscale Embedded DERP
    stun_listen_addr: 0.0.0.0:{{ .STUNPort }}
    private_key_path: /var/lib/headscale/derp_server_private.key
    automatically_add_embedded_derp_region: true
  urls: []
  paths: []
  auto_update_enabled: false
  update_frequency: 24h
disable_check_updates: true
node:
  ephemeral:
    inactivity_timeout: 30m
database:
  type: sqlite
  sqlite:
    path: /var/lib/headscale/db.sqlite
log:
  format: text
  level: info
dns:
  magic_dns: true
  override_local_dns: false
  base_domain: rune.test
  nameservers:
    global:
      - 1.1.1.1
policy:
  mode: database
