//kage:unit pixels

package main

var Progress float
var Resolution vec2
var Background vec4
var Seed float

// Speed is how many times the fire's noise changes over a run.
var Speed float

// Hue turns the fire's colours, in turns: at 0 it burns red.
var Hue float

// SwapRedBlue, when 1, swaps red and blue after turning the hue.
var SwapRedBlue float

// Strength is how far the fire stands out from the background, from 0 to
// 1.
var Strength float

// Remixed from codevinsky's Fire (https://www.shadertoy.com/view/XsXXRN).
func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	frag := vec2(dstPos.x, Resolution.y-dstPos.y)
	seed := seedOffset(Seed)
	p := frag * 8 / Resolution.x

	q := layer(p, 0, seed)
	r := vec2(layer(vec2(q-p.y, q-p.x), 1, seed), layer(p+q, 2, seed))
	c := mix(vec3(0.5, 0, 0.1), vec3(0.9, 0.1, 0), layer(p+r, 3, seed)) +
		mix(vec3(0.2, 0.1, 0.7), vec3(1, 0.9, 0.1), r.x) -
		mix(vec3(0.1), vec3(0.9), r.y)
	col := clamp(c*cos(1.6*frag.y/Resolution.y), 0, 1)
	if Hue != 0 {
		hsv := rgb2hsv(col)
		hsv.x = fract(hsv.x + Hue)
		col = hsv2rgb(hsv)
	}
	if SwapRedBlue > 0.5 {
		col = col.zyx
	}
	return mix(Background, vec4(col, 1), Strength)
}

// layer is the noise of the i-th of the layers the fire is made of.
func layer(p vec2, i float, seed float) float {
	return fbm(p, Progress, Speed, seed+i*101, 4, 2, 0.5)
}
